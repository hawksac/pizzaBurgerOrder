<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.SecondaryController">
    <Label text="Receipt:"/>
    <ScrollPane fitToWidth="true">
        <content>
            <TextArea fx:id="receiptDisplay" editable="false" wrapText="true"/>
        </content>
    </ScrollPane>
    <Label fx:id="totalLabel" text="Grand Total: $0.00"/>
    <Button text="Back to Order" onAction="#switchToPrimary"/>
</VBox>
