<?xml version="1.0" encoding="UTF-8"?>

<!-- Typical imports; notice the import of java.lang.String -->
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox fx:controller="com.example.CustomPizzaController"
      xmlns="http://javafx.com/javafx/8.0.171-ea"
      xmlns:fx="http://javafx.com/fxml/1" spacing="10">

    <Label text="Order Your Custom Pizza"/>

    <!-- Crust selection -->
    <HBox spacing="5">
        <Label text="Crust:"/>
        <ComboBox fx:id="crustCombo">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Thin Crust"/>
                    <String fx:value="Thick Crust"/>
                </FXCollections>
            </items>
        </ComboBox>
    </HBox>

    <!-- Sauce selection -->
    <HBox spacing="5">
        <Label text="Sauce:"/>
        <ComboBox fx:id="sauceCombo">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Tomato Sauce"/>
                    <String fx:value="Alfredo Sauce"/>
                </FXCollections>
            </items>
        </ComboBox>
    </HBox>
    
    <!-- Toppings selection -->
    <Label text="Select Toppings (max 4):" />
    <HBox spacing="10" alignment="CENTER_LEFT">
        <CheckBox fx:id="toppingPepperoni" text="Pepperoni"/>
        <CheckBox fx:id="toppingMushroom" text="Mushrooms"/>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <CheckBox fx:id="toppingSausage" text="Sausage"/>
        <CheckBox fx:id="toppingMozzarella" text="Mozzarella"/>
        <CheckBox fx:id="toppingAsiago" text="Asiago"/>
    </HBox>
    
    <!-- Additional Customization: Pizza Size -->
    <HBox spacing="5" alignment="CENTER_LEFT">
        <Label text="Pizza Size:"/>
        <ComboBox fx:id="sizeCombo">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Small"/>
                    <String fx:value="Medium"/>
                    <String fx:value="Large"/>
                </FXCollections>
            </items>
        </ComboBox>
    </HBox>

    <!-- Action Buttons -->
    <HBox spacing="20" alignment="CENTER">
        <Button text="Submit" onAction="#submitCustomPizza"/>
        <Button text="Cancel" onAction="#cancel"/>
    </HBox>
    
</VBox>
